{
  "$schema": "https://raw.githubusercontent.com/DavidAnson/markdownlint-cli2/main/schema/markdownlint-cli2-config-schema.json",
  "config": {
    "default": true,
    "MD013": false,
    "MD022": false,
    "MD031": false,
    "MD032": false,
    "MD033": false,
    "MD024": {
      "siblings_only": true
    },
    "MD041": false
  },
  "ignores": [
    "node_modules",
    "tmp",
    ".git",
    "target"
  ]
}
