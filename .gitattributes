# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicit text files
*.java text diff=java eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.cmd text eol=crlf
*.ps1 text eol=crlf
Makefile text eol=lf

# Configuration files
.editorconfig text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
.dockerignore text eol=lf
.java-version text eol=lf
.markdownlint-cli2.jsonc text eol=lf
.yamllint text eol=lf
.checkstyle.xml text eol=lf

# Binary media files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.jar binary
